# Backend settings. Keep real values in an ignored .env file.
# Example for this workstation: postgresql+psycopg://resume_app:<URL-encoded-password>@127.0.0.1:1111/resume_ats
DATABASE_URL=
GEMINI_API_KEY=
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_MAX_MB=10
ENVIRONMENT=development

# Frontend setting. Vite exposes VITE_ variables to browser code,
# so only put public, non-secret values here.
VITE_API_BASE_URL=http://127.0.0.1:8000

