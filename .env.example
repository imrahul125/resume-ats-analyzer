# Backend settings. Keep real values in an ignored .env file.
DATABASE_URL=
GEMINI_API_KEY=
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
UPLOAD_MAX_MB=10
ENVIRONMENT=development

# Frontend setting. Vite exposes VITE_ variables to browser code,
# so only put public, non-secret values here.
VITE_API_BASE_URL=http://localhost:8000

